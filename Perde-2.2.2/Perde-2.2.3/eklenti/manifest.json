{
  "manifest_version": 3,
  "name": "Perde — Yerel Görüntü ve Ses Koruması",
  "version": "2.2.2",
  "minimum_chrome_version": "120",
  "description": "Yerel insan/yüz maskeleme, isteğe bağlı site koruması, YouTube reklam susturma ve yerel vokal ayırma.",
  "permissions": [
    "storage",
    "offscreen",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*",
    "https://*.ytimg.com/*",
    "https://*.ggpht.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Perde",
    "default_icon": "icons/128.png"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "settings.js",
        "tracking.js",
        "motion.js",
        "content.js",
        "audio-content.js",
        "gambling.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
